#!/bin/sh /etc/rc.common
# modemd 守护进程（procd 托管）。LF 行尾。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/modemd
CONFIG=/etc/modemd/config.toml

start_service() {
	# 配置里的 log_file 默认落在 /var/log；OpenWrt 上 /var 是 tmpfs 软链到 /tmp，
	# 有些精简固件开机时还没有这个目录 —— 缺了它日志会静默丢（只能 logread 看）。
	# 这里补一下：目录已存在时 mkdir -p 是空操作，无副作用。
	[ -d /var/log ] || mkdir -p /var/log 2>/dev/null

	procd_open_instance
	procd_set_param command "$PROG" -config "$CONFIG"
	procd_set_param respawn 3600 5 5
	# 退出钩子要落盘台账、拆 QMI 承载（Stop 请求最多等 15 秒），默认 5 秒不够：
	# 给 20 秒，避免 procd 直接 SIGKILL 导致最后一笔配置丢失。
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONFIG"
	procd_close_instance
}

reload_service() {
	stop
	start
}

# ⚠️ 这里**不要**加 procd_add_reload_trigger "modemd"：那个函数监视的是
# UCI 配置文件 /etc/config/modemd，而本服务用的是 /etc/modemd/config.toml，
# 那条触发器会永久空转（历史上的写法）。
# config.toml 的变更已由上面的 procd_set_param file "$CONFIG" 覆盖：
# 改动后 procd 会自动重启本服务，无需额外的 reload trigger。

extra_command "status" "显示守护进程状态" do_status

do_status() {
	if pgrep -f "$PROG" >/dev/null 2>&1; then
		echo "modemd 正在运行（pid $(pgrep -f "$PROG" | head -1)）"
	else
		echo "modemd 未运行"
	fi
}
