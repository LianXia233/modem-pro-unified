#!/bin/sh
# modem-pro 安装后（postinst）。IPKG_INSTROOT 非空 = 在离线 rootfs 预装，不启动服务。
[ -n "$IPKG_INSTROOT" ] && exit 0

chmod +x /usr/bin/modemd 2>/dev/null
for s in /lib/netifd/proto/modem_pro.sh /usr/lib/modem-pro/mp-client.sh; do
	[ -f "$s" ] && chmod +x "$s" 2>/dev/null
done

# LuCI 缓存与静态资源：升级后 dispatcher 的菜单索引缓存必须清掉，
# 否则旧菜单树（子页面结构）会一直用到下次重启；apk 安装的文件 mtime 是
# 1970-01-01，会让浏览器对旧 JS 的启发式缓存几乎永久有效 —— 统一 touch 成
# 当前时间，ETag/Last-Modified 随之变化，浏览器重新验证即可拿到新版本。
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache /tmp/luci-menu.json 2>/dev/null
find /www/luci-static/resources/view/modemd /www/luci-static/resources/modemd \
     /usr/share/luci/menu.d /usr/share/rpcd/acl.d -type f \
     -exec touch {} + 2>/dev/null

# 升级清理：2026-10-19 起 QMI/MBIM 拨号已内化进 modemd，旧包留下的厂商二进制
# 与 quectel.sh 协议脚本不再使用（不清掉会白占几百 KB，且误导排障）。
rm -f /usr/lib/modemd/quectel-CM /usr/lib/modemd/fibocom-dial \
      /usr/lib/modemd/meig-cm /usr/lib/modemd/simcom-cm 2>/dev/null
rmdir /usr/lib/modemd 2>/dev/null
rm -f /lib/netifd/proto/quectel.sh 2>/dev/null

# 注册并拉起服务
/etc/init.d/modemd enable 2>/dev/null
/etc/init.d/modemd restart 2>/dev/null

# 清 LuCI 缓存，让新控制器/菜单立即生效
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.* 2>/dev/null
rm -rf /tmp/luci-modulecache 2>/dev/null
[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload 2>/dev/null
[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd reload 2>/dev/null

_port=$(sed -n 's/.*listen[[:space:]]*=[[:space:]]*"[^"]*:\([0-9][0-9]*\)".*/\1/p' /etc/modemd/config.toml 2>/dev/null | head -1)
case "$_port" in ''|*[!0-9]*) _port=9527 ;; esac

echo "modem-pro 已安装（modemd + 内置 QMI/MBIM 拨号 + LuCI）："
echo "  服务：  /etc/init.d/modemd status | start | stop | restart"
echo "  配置：  /etc/modemd/config.toml（改完 restart 生效）"
echo "  页面：  http://<路由器地址>:$_port/   或 LuCI 菜单「5G终端」"
echo "  日志：  logread -e modemd   （或 /var/log/modemd.log）"
echo ""
echo "模组接口 proto=modem_pro 承载 IPv4(DHCP)+IPv6(SLAAC/DHCPv6)；"
echo "QMI/MBIM 数据呼叫由 modemd 内置建立（QMAP 模组自动发 WDA 并绑 mux），无需外部拨号器。"
exit 0
